{
  "entries": [
    {
      "id": "session-start:routing-reminder",
      "event": "session-start",
      "command": "bash \"${OPENCODE_PLUGIN_ROOT}\"/hooks/scripts/routing-reminder.sh",
      "timeoutMs": 5000
    },
    {
      "id": "pre-tool:intercept-git-commit",
      "event": "pre-tool",
      "matcher": "Bash|mcp__.*git.*commit",
      "command": "bash \"${OPENCODE_PLUGIN_ROOT}\"/hooks/scripts/intercept-git-commit.sh",
      "timeoutMs": 5000
    }
  ]
}
