{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/routing-reminder.sh",
            "timeout": 5,
            "statusMessage": "Load git commit workflow rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*git.*commit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/intercept-git-commit.sh",
            "timeout": 5,
            "statusMessage": "Validate git commit format and require commit skill"
          }
        ]
      }
    ]
  }
}
