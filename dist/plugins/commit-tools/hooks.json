{
  "commit-tools/session-start:routing-reminder": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash runtime/antigravity/hook-shim.sh session-start:routing-reminder",
        "timeout": 10
      }
    ]
  },
  "commit-tools/pre-tool:intercept-git-commit": {
    "PreToolUse": [
      {
        "matcher": "^(?:run_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash runtime/antigravity/hook-shim.sh pre-tool:intercept-git-commit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
