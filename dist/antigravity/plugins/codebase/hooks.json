{
  "codebase/session-start:session-reminder": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash runtime/antigravity/hook-shim.sh session-start:session-reminder",
        "timeout": 15
      }
    ]
  },
  "codebase/pre-tool:pretooluse-grep": {
    "PreToolUse": [
      {
        "matcher": "^(?:run_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash runtime/antigravity/hook-shim.sh pre-tool:pretooluse-grep",
            "timeout": 5005
          }
        ]
      }
    ]
  }
}
