{
  "entries": [
    {
      "plugin": "codebase",
      "id": "session-start:session-reminder",
      "event": "session-start",
      "matcher": "startup|resume|clear|compact",
      "command": "bash \"${OMP_PLUGIN_ROOT}\"/hooks/session-reminder.sh"
    },
    {
      "plugin": "codebase",
      "id": "subagent-start:subagent-reminder",
      "event": "subagent-start",
      "command": "bash \"${OMP_PLUGIN_ROOT}\"/hooks/subagent-reminder.sh"
    },
    {
      "plugin": "codebase",
      "id": "pre-tool:discovery-augment",
      "event": "pre-tool",
      "matcher": "Grep|Glob",
      "command": "bash \"${OMP_PLUGIN_ROOT}\"/hooks/discovery-augment.sh",
      "timeoutMs": 5000
    }
  ]
}
